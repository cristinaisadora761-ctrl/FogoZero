# ===================================================
# FogoZero - Arquivo de Configuração de Exemplo
# Copie este arquivo para .env e ajuste conforme necessário
# ===================================================

# Porta do Servidor Local
PORT=3000

# Ambiente de Execução (development | production)
NODE_ENV=development

# Configuração do Banco de Dados
# SGBD Padrão: SQLite nativo (não exige instalação de servidor externo)
DB_TYPE=sqlite
DB_FILE=database/fogozero.db

# Configurações opcionais para caso deseje utilizar MySQL / MariaDB:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=fogozero_db
# DB_USER=root
# DB_PASS=

# Chave Secreta da Sessão / Token (Segurança)
SESSION_SECRET=fogozero_chave_secreta_desenvolvimento_local_2026
